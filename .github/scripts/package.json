{
  "name": "scripts",
  "version": "1.0.0",
  "description": "@patina-network/hello-world-clients CI Scripts",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun run prettier && bun run lint && bun test",
    "fix": "bun run eslint:fix && bun run prettier:fix",
    "lint": "bun run eslint",
    "eslint": "eslint .",
